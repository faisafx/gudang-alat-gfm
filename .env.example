# Konfigurasi GFM Gudang Alat — PT Sulawesi Cahaya Mineral
# Salin file ini menjadi ".env" (dibuat otomatis oleh mulai-gudang.bat / install-windows.ps1).

# Aktifkan HTTPS lokal supaya kamera HP/tablet bisa dipakai untuk scan QR di WiFi
HTTPS=on

# Port HTTP (untuk Mini PC & scanner Bluetooth) dan Port HTTPS (untuk kamera HP/tablet)
# Port 3050 & 3450 dipilih agar tidak bentrok dengan sistem monitoring WTP/WWTP (port 3000)
PORT=3050
HTTPS_PORT=3450

# PIN menu Data (khusus penjaga gudang) — WAJIB diganti
ADMIN_PIN=1234

# Setelah berapa jam alat dianggap "lewat shift"
SHIFT_HOURS=12

# Zona waktu untuk export CSV (WITA = Sulawesi Tenggara). WIB: Asia/Jakarta, WIT: Asia/Jayapura
APP_TZ=Asia/Makassar

# Backup harian otomatis disimpan di data/backup, simpan sebanyak N hari
BACKUP_KEEP=60
# Opsional: arahkan backup ke disk/flashdisk lain
# BACKUP_DIR=D:\BackupGudang
